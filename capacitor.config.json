{
  "appId": "com.saystudios.littledays",
  "appName": "Little Days",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": true,
    "backgroundColor": "#fff8f1",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 2000,
      "backgroundColor": "#fff8f1",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "StatusBar": {
      "overlaysWebView": true
    }
  }
}
